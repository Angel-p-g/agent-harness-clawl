{
  "name": "@dsh-mini/bundle-base",
  "version": "0.1.0-alpha.0",
  "description": "Shared base bundle: kernel services, one provider per seam, and the minimal tool set",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["cordis.patch.yml", "lib", "src"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.12"
  },
  "dependencies": {
    "@cordisjs/plugin-timer": "^1.1.4",
    "@dsh-mini/agent": "workspace:*",
    "@dsh-mini/agent-loop": "workspace:*",
    "@dsh-mini/fs": "workspace:*",
    "@dsh-mini/fs-local": "workspace:*",
    "@dsh-mini/llm": "workspace:*",
    "@dsh-mini/llm-deepseek": "workspace:*",
    "@dsh-mini/scope": "workspace:*",
    "@dsh-mini/session": "workspace:*",
    "@dsh-mini/system-prompt": "workspace:*",
    "@dsh-mini/tool-fs": "workspace:*",
    "@dsh-mini/tool-web": "workspace:*",
    "@dsh-mini/tools": "workspace:*",
    "@dsh-mini/web": "workspace:*",
    "@dsh-mini/web-fetch-http": "workspace:*",
    "@dsh-mini/web-search-brave": "workspace:*"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.12"
  }
}
