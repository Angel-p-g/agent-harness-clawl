{
  "name": "@dsh-mini/cli",
  "version": "0.1.0-alpha.0",
  "description": "The dsh-mini executable: profile selection and headless entry point",
  "private": true,
  "type": "module",
  "bin": {
    "dsh-mini": "./lib/bin.js"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src"],
  "dependencies": {
    "@cordisjs/plugin-include": "1.2.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@dsh-mini/app-boot": "workspace:*",
    "@dsh-mini/bundle-base": "workspace:*",
    "@dsh-mini/profile-headless": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "node-addon-require-builtin": "^0.1.4"
  }
}
