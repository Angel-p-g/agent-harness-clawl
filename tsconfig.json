{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "packages/*/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/lib/**",
    "tests/.artifacts/**"
  ]
}
